# --- Auth ---
JWT_SECRET=            # long random string, e.g. `openssl rand -hex 32`
ADMIN_KEY=              # a password only you know, used to create employee logins

# --- Database ---
DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Payments (Stripe) ---
# Get these from the Stripe Dashboard (Developers > API keys, and
# Developers > Webhooks after you register the webhook endpoint URL below).
# Use the test-mode keys (sk_test_.../whsec_test values) until you're ready
# to accept real payments, then switch to the live-mode keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Stripe Connect (other companies paying into their own account) ---
# Just requires Connect turned on for your platform account (Settings >
# Connect in the Stripe Dashboard, choose Standard accounts) -- no Client ID
# or OAuth setup needed, since onboarding uses Stripe's newer Account Links
# flow (routes/connect.js). Create a SECOND webhook destination scoped to
# "Connected accounts" (not "Your account" like the one above) pointing at
# https://<your-backend-url>/api/payments/connect-webhook, and paste its own
# signing secret below -- it's different from STRIPE_WEBHOOK_SECRET.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Every company -- including your own Modular Cleanrooms -- must connect
# its own Stripe account via the "Connect Stripe" button in Billing before
# it can accept online invoice payments. There's no exception for any one
# company; see routes/payments.js for why.

# --- Backend URL ---
# This server's own public URL, used to build the return_url/refresh_url
# Stripe redirects a company's browser to during Connect onboarding.
BACKEND_URL=https://your-backend-url.up.railway.app

# --- Error monitoring (Sentry) ---
# Create a free project at sentry.io, then paste its DSN here. Leave blank
# to run without error monitoring (errors will still log to the console).
SENTRY_DSN=

# --- Frontend URL ---
# Used to build links in emails (password reset, invoice/quote links, etc).
FRONTEND_URL=https://your-app-domain.com

# --- Email (currently Resend) ---
# Actual outgoing email (timesheets, password/PIN reset, invoices, quotes)
# goes through Resend's API, not the Gmail SMTP settings below (those are
# legacy/unused -- kept only for the PAYROLL_EMAIL destination address).
# Get a key at resend.com/api-keys, and verify a sending domain/address
# at resend.com/domains to set RESEND_FROM.
RESEND_API_KEY=
RESEND_FROM=you@yourdomain.com

# --- Email (legacy Gmail config, currently unused) ---
# Gmail requires an "App Password", not your normal password:
#   1. Turn on 2-Step Verification on the Google account: myaccount.google.com/security
#   2. Go to myaccount.google.com/apppasswords
#   3. Create one for "Mail" / "Other (Time Clock)" and use the 16-character
#      code below as SMTP_PASS. Regular Gmail passwords will be rejected.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=              # the 16-char app password, not your login password
SMTP_FROM=you@gmail.com

# Where submitted timesheets land (can be the same as SMTP_USER, or a
# separate payroll inbox)
PAYROLL_EMAIL=you@gmail.com

# --- Switching providers later ---
# Moving to another address or a transactional provider (Postmark,
# SendGrid, Amazon SES, your own domain's mail server, etc.) only means
# updating SMTP_HOST/PORT/USER/PASS above — mailer.js doesn't change.
# Two things worth knowing when that day comes:
#   - Gmail caps outgoing mail around 500/day on a free account, which is
#     irrelevant at your team size but worth knowing if that ever changes.
#   - Gmail SMTP can be flaky about deliverability for automated/bulk mail
#     over time; a dedicated provider like Postmark is more reliable if
#     you're sending from a business domain.
